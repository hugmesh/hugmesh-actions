<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.5</version>
		<relativePath/>
	</parent>

	<groupId>systems.snapdragon</groupId>
	<artifactId>snapdragon-actions</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>snapdragon-actions</name>
	<description>Snapdragon platform-wide scheduled actions (cross-stack role sync, audit log, …)</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!-- Reactive web client + scheduling — the actions service polls
		     Casdoor admin APIs on a timer; everything reactive so a
		     long-running tick doesn't block the scheduler thread. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Prometheus metrics on /actuator/prometheus — every sync tick
		     emits gauges + counters for grants applied / removed /
		     skipped. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Security + OAuth2 resource server. Wires the @PreAuthorize
		     gates on the registration endpoints + restricts /actuator
		     to ROLE_GAME-MASTER. Same Casdoor authority shape the BFF
		     and the gateways consume. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Resilience4j circuit breaker — wraps the per-Casdoor-call
		     side-effect so a slow Casdoor doesn't pile up sync work. -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3</artifactId>
			<version>2.2.0</version>
		</dependency>
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-reactor</artifactId>
			<version>2.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Spring Security test support — SecurityMockServerConfigurers
		     .mockJwt() seeds a synthetic Casdoor JWT so the SecurityConfig
		     path-matcher + authority-converter rules can be asserted with
		     WebTestClient (no live Casdoor / JWKS needed). -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- GraalVM native-image build tooling. The version + the
			     process-aot / add-reachability-metadata executions are
			     contributed by the spring-boot-starter-parent `native`
			     profile's pluginManagement (id=native); declaring the
			     plugin here activates those bindings when the build runs
			     with `-Pnative`. Mirrors snapdragon-gateway/pom.xml. -->
			<plugin>
				<groupId>org.graalvm.buildtools</groupId>
				<artifactId>native-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Native build: `./mvnw -Pnative native:compile` produces a
		     GraalVM binary. The `native` profile itself (process-aot +
		     reachability metadata) is defined by spring-boot-starter-parent;
		     this thin local profile only mirrors the gateway so the same
		     `-Pnative` invocation works across the platform and gives a
		     home for any future actions-specific native config. -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
